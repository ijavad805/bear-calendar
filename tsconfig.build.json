{
    "compilerOptions": {
        "module": "esnext",
        "lib": ["dom", "esnext", "es2020"],
        "importHelpers": true,
        "declaration": true,
        "sourceMap": true,
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": false,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "node",
        "jsx": "react",
        "esModuleInterop": true,
        "target": "ES2020"
    }
}
